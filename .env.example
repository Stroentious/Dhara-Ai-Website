# ==========================================
# DHARA AI - ENVIRONMENT VARIABLES SPECIFICATION
# Phase 0 Configuration Template
# ==========================================

# Core Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Authentication & Security Secrets
# Replace in local .env with a strong cryptographically generated string (e.g., openssl rand -base64 32)
JWT_SECRET=development_jwt_secret_do_not_use_in_production_min32chars

# Primary Relational Database (PostgreSQL / TimescaleDB compatible)
DATABASE_URL=postgresql://dhara_user:dhara_password@localhost:5432/dhara_db?schema=public

# ------------------------------------------
# FUTURE PHASES INTEGRATION PLACEHOLDERS
# ------------------------------------------

# MQTT Broker (Phase 6 Integration)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Redis Cache & Realtime Infrastructure (Future Architectural Option)
REDIS_URL=redis://localhost:6379

# AI Decision Engine Service Boundary (Phase 10 Integration)
AI_API_KEY=
