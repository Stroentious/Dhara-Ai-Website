# Database configuration: SQLite default for local dev. For PostgreSQL, set: postgresql://dharaai:password@localhost:5432/dharaai_db
DATABASE_URL=sqlite:///./dharaai_local.db
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=your-groq-api-key-here
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key-here
LORA_DEVICE_SECRET=your-lora-shared-secret-here
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
ENVIRONMENT=development
HARDWARE_MODE=SIMULATION
