# Database configuration: SQLite default for instant zero-setup local dev.
# For PostgreSQL: DATABASE_URL=postgresql://dharaai:password@localhost:5432/dharaai_db
DATABASE_URL=sqlite:///./dharaai_local.db
SECRET_KEY=dharaai-dev-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GROQ_API_KEY=
OPENWEATHERMAP_API_KEY=
LORA_DEVICE_SECRET=dev-lora-secret
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
ENVIRONMENT=development
HARDWARE_MODE=SIMULATION
